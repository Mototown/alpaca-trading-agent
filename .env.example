# ── Alpaca credentials (paper trading) ──────────────────────────────────────
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=true

# ── Alpaca MCP server ────────────────────────────────────────────────────────
# Local MCP server URL (default: run via Docker on port 3001)
MCP_SERVER_URL=http://localhost:3001/mcp

# ── LLM provider (used on Day 3+ for debate sub-agents) ─────────────────────
# Set one of these; leave the other blank
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Comma-separated list of equity symbols to watch and hedge
WATCHLIST=["SPY","QQQ","AAPL","MSFT"]

# How often to run the decision loop (seconds)
LOOP_INTERVAL_SECONDS=300

# Maximum percentage of portfolio equity to spend on options per tick (0-1)
MAX_HEDGE_PCT=0.02

# Target net portfolio delta (0 = delta neutral, 1 = fully long)
TARGET_DELTA=0.10

# Maximum net portfolio delta before forced hedge
MAX_DELTA=0.30

# Daily loss limit as fraction of starting equity (0-1)
DAILY_LOSS_LIMIT=0.03

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/daha.db

# ── Dry-run mode: log decisions but do not place orders ──────────────────────
DRY_RUN=false
